{
  "appId": "com.matkabook",
  "appName": "MatkaBook",
  "webDir": "www",
  "bundledWebRuntime": false,
  "server": {
    "url": "https://matkabook.win/app",
    "allowNavigation": ["*", "ekqr.in", "*.ekqr.in"],
    "cleartext": true
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    },
    "StatusBar": {
      "overlaysWebView": false,
      "backgroundColor": "#000000",
      "style": "DARK"
    }
  }
}
